; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="底池训练器"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://assets/ui/pot-launcher.png"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
FirebaseAuth="*res://scripts/autoload/firebase_auth.gd"
Locale="*res://scripts/autoload/locale.gd"
GoogleSignIn="*res://scripts/autoload/google_sign_in.gd"
AppleSignIn="*res://scripts/autoload/apple_sign_in.gd"
AdMobManager="*res://scripts/autoload/admob_manager.gd"
GuestModeManager="*res://scripts/autoload/guest_mode_manager.gd"
SubscriptionManager="*res://scripts/autoload/subscription_manager.gd"
DialogQueue="*res://scripts/autoload/dialog_queue.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[gui]

theme/custom_font="res://assets/fonts/NotoSansSC-Regular.otf"

[rendering]

textures/vram_compression/import_etc2_astc=true
